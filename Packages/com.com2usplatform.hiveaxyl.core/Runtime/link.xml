<?xml version="1.0" encoding="utf-8"?>
<!--
  IL2CPP managed code stripping prevention for the Hive Axyl Core release UPM.

  The release form has two assemblies (see com.com2usplatform.hiveaxyl.core.asmdef):
    - Hive.Axyl.Core.Internal : precompiled DLL (Runtime/Core/*.cs)
    - Hive.Axyl.Core          : adapter assembly compiled from Runtime/Unity/*.cs
                                via the asmdef; references the DLL.

  Both need preservation:
    - The DLL holds reflection-reachable code paths.
    - The adapter assembly holds [MonoPInvokeCallback] trampolines
      (JslibInterop, PInvokeInterop, JniBridgeCallback) that are only
      reached from native code and would otherwise be stripped.

  System.Globalization.CultureInfo is used in UnityAppEnvironment for BCP 47
  language detection; strip levels may drop the CultureInfo lookup tables
  if it appears unreferenced at static analysis time.
-->
<linker>
  <assembly fullname="Hive.Axyl.Core" preserve="all"/>
  <assembly fullname="Hive.Axyl.Core.Internal" preserve="all"/>
  <assembly fullname="System.Globalization">
    <type fullname="System.Globalization.CultureInfo" preserve="all"/>
  </assembly>
  <assembly fullname="mscorlib">
    <type fullname="System.Globalization.CultureInfo" preserve="all"/>
  </assembly>
</linker>
